// =========================================================================
// 13. ADVANCED COMMISSIONS & ARTHI BROKERAGE
// =========================================================================

enum AgentCommissionType {
  PERCENTAGE
  PER_BAG
  PER_KG
}

enum CommTransactionStatus {
  ACCRUED
  PAID
  CANCELLED
}

model CommissionAgent {
  id             String                  @id @default(uuid())
  code           String                  @unique @db.VarChar(50)
  name           String                  @db.VarChar(150)
  phone          String?                 @db.VarChar(50)
  mandiCity      String?                 @db.VarChar(100)
  commissionType AgentCommissionType     @default(PERCENTAGE)
  defaultRate    Decimal                 @default(1.0000) @db.Decimal(18, 4)
  currentBalance Decimal                 @default(0.0000) @db.Decimal(18, 4)
  notes          String?                 @db.Text
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  transactions   CommissionTransaction[]
  payments       CommissionPayment[]
}

model CommissionTransaction {
  id                String                @id @default(uuid())
  transactionNumber String                @unique @db.VarChar(50)
  agentId           String
  agent             CommissionAgent       @relation(fields: [agentId], references: [id])
  transactionDate   DateTime              @default(now())
  referenceType     String                @db.VarChar(50) // SALE, DAILY_SALES, PURCHASE
  referenceNo       String                @db.VarChar(100)
  baseAmount        Decimal               @default(0.0000) @db.Decimal(18, 4)
  bagCount          Int                   @default(0)
  weightKg          Decimal               @default(0.0000) @db.Decimal(18, 4)
  rateType          AgentCommissionType   @default(PERCENTAGE)
  rateValue         Decimal               @default(0.0000) @db.Decimal(18, 4)
  commissionAmount  Decimal               @db.Decimal(18, 4)
  status            CommTransactionStatus @default(ACCRUED)
  notes             String?               @db.Text
  createdAt         DateTime              @default(now())

  @@index([agentId])
  @@index([referenceNo])
}

model CommissionPayment {
  id              String          @id @default(uuid())
  paymentNumber   String          @unique @db.VarChar(50)
  agentId         String
  agent           CommissionAgent @relation(fields: [agentId], references: [id])
  paymentDate     DateTime        @default(now())
  amount          Decimal         @db.Decimal(18, 4)
  paymentMethod   PaymentType     @default(CASH)
  cashAccountId   String?
  cashAccount     CashAccount?    @relation("AgentPaymentCash", fields: [cashAccountId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?    @relation("AgentPaymentBank", fields: [bankAccountId], references: [id])
  referenceNumber String?         @db.VarChar(100)
  notes           String?         @db.Text
  status          String          @default("POSTED") @db.VarChar(20)
  reversalRef     String?         @db.VarChar(50)
  createdAt       DateTime        @default(now())

  @@index([agentId])
}

// =========================================================================
// 14. INTERNATIONAL RICE EXPORT & SHIPPING
// =========================================================================

enum ExportInvoiceStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  REALIZED
  CANCELLED
}

enum Incoterm {
  FOB
  CIF
  CFR
}

model ExportCustomer {
  id                   String          @id @default(uuid())
  customerCode         String          @unique @db.VarChar(50)
  companyName          String          @db.VarChar(150)
  country              String          @db.VarChar(100)
  contactPerson        String?         @db.VarChar(100)
  email                String?         @db.VarChar(100)
  phone                String?         @db.VarChar(50)
  address              String?         @db.Text
  preferredCurrency    String          @default("USD") @db.VarChar(10)
  destinationPort      String?         @db.VarChar(100)
  paymentTerms         String?         @db.VarChar(100) // e.g. 100% LC at sight, 30% Advance TT
  taxId                String?         @db.VarChar(50)
  currentReceivableFcy Decimal         @default(0.0000) @db.Decimal(18, 4)
  currentReceivablePkr Decimal         @default(0.0000) @db.Decimal(18, 4)
  notes                String?         @db.Text
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  invoices             ExportInvoice[]
  payments             ExportPayment[]
}

model ExportInvoice {
  id                 String              @id @default(uuid())
  invoiceNumber      String              @unique @db.VarChar(50)
  exportCustomerId   String
  exportCustomer     ExportCustomer      @relation(fields: [exportCustomerId], references: [id])
  invoiceDate        DateTime            @default(now())
  currency           String              @default("USD") @db.VarChar(10)
  exchangeRate       Decimal             @default(280.0000) @db.Decimal(18, 4) // PKR per FCY
  contractNo         String?             @db.VarChar(100)
  paymentTerms       String?             @db.VarChar(100)
  incoterm           Incoterm            @default(FOB)
  portOfLoading      String              @default("Karachi Port, Pakistan") @db.VarChar(100)
  portOfDischarge    String?             @db.VarChar(100)
  vesselName         String?             @db.VarChar(100)
  containerNumber    String?             @db.VarChar(100)
  blNumber           String?             @db.VarChar(100)
  shippingLine       String?             @db.VarChar(100)
  oceanFreightCost   Decimal             @default(0.0000) @db.Decimal(18, 4)
  portHandlingCost   Decimal             @default(0.0000) @db.Decimal(18, 4)
  otherShippingCosts Decimal             @default(0.0000) @db.Decimal(18, 4)
  totalFreightCostPkr Decimal            @default(0.0000) @db.Decimal(18, 4)
  totalFcyAmount     Decimal             @default(0.0000) @db.Decimal(18, 4)
  totalPkrAmount     Decimal             @default(0.0000) @db.Decimal(18, 4)
  paidFcyAmount      Decimal             @default(0.0000) @db.Decimal(18, 4)
  paidPkrAmount      Decimal             @default(0.0000) @db.Decimal(18, 4)
  status             ExportInvoiceStatus @default(DRAFT)
  notes              String?             @db.Text
  items              ExportInvoiceItem[]
  payments           ExportPayment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([exportCustomerId])
  @@index([status])
}

model ExportInvoiceItem {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       ExportInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String
  product       RiceProduct   @relation(fields: [productId], references: [id])
  bagType       String        @default("PP Non-Woven Bag") @db.VarChar(50)
  bagWeightKg   Decimal       @default(40.0000) @db.Decimal(18, 4)
  bagCount      Int           @default(0)
  totalWeightKg Decimal       @db.Decimal(18, 4)
  totalWeightMt Decimal       @db.Decimal(18, 4)
  ratePerMtFcy  Decimal       @db.Decimal(18, 4)
  lineTotalFcy  Decimal       @db.Decimal(18, 4)
  lineTotalPkr  Decimal       @db.Decimal(18, 4)
  grainLengthMm Decimal?      @db.Decimal(5, 2)
  moisturePct   Decimal?      @db.Decimal(5, 2)
  brokenPct     Decimal?      @db.Decimal(5, 2)
  notes         String?       @db.Text

  @@index([invoiceId])
  @@index([productId])
}

model ExportPayment {
  id                   String         @id @default(uuid())
  paymentNumber        String         @unique @db.VarChar(50)
  exportInvoiceId      String
  exportInvoice        ExportInvoice  @relation(fields: [exportInvoiceId], references: [id])
  exportCustomerId     String
  exportCustomer       ExportCustomer @relation(fields: [exportCustomerId], references: [id])
  paymentDate          DateTime       @default(now())
  realizationDate      DateTime       @default(now())
  currency             String         @default("USD") @db.VarChar(10)
  amountFcy            Decimal        @db.Decimal(18, 4)
  realizedExchangeRate Decimal        @db.Decimal(18, 4)
  amountPkr            Decimal        @db.Decimal(18, 4)
  bankChargesPkr       Decimal        @default(0.0000) @db.Decimal(18, 4)
  exchangeGainLossPkr  Decimal        @default(0.0000) @db.Decimal(18, 4)
  bankAccountId        String?
  bankAccount          BankAccount?   @relation("ExportPaymentBank", fields: [bankAccountId], references: [id])
  bankRefNo            String?        @db.VarChar(100)
  notes                String?        @db.Text
  status               String         @default("POSTED") @db.VarChar(20)
  createdAt            DateTime       @default(now())

  @@index([exportInvoiceId])
  @@index([exportCustomerId])
}

// =========================================================================
// 15. INTER-WAREHOUSE TRANSFERS & GODOWN LOGISTICS
// =========================================================================

enum TransferStatus {
  PENDING_APPROVAL
  IN_TRANSIT
  RECEIVED
  REJECTED
}

model WarehouseTransfer {
  id                  String                  @id @default(uuid())
  transferNumber      String                  @unique @db.VarChar(50)
  transferDate        DateTime                @default(now())
  fromWarehouseId     String
  fromWarehouse       Warehouse               @relation("TransferSourceWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId       String
  toWarehouse         Warehouse               @relation("TransferDestinationWarehouse", fields: [toWarehouseId], references: [id])
  driverName          String?                 @db.VarChar(100)
  vehicleNumber       String?                 @db.VarChar(50)
  biltyNumber         String?                 @db.VarChar(100)
  status              TransferStatus          @default(PENDING_APPROVAL)
  totalBags           Int                     @default(0)
  totalWeightKg       Decimal                 @default(0.0000) @db.Decimal(18, 4)
  transitLossBags     Int                     @default(0)
  transitLossWeightKg Decimal                 @default(0.0000) @db.Decimal(18, 4)
  approvedById        String?
  approvedAt          DateTime?
  receivedById        String?
  receivedAt          DateTime?
  notes               String?                 @db.Text
  items               WarehouseTransferItem[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model WarehouseTransferItem {
  id               String            @id @default(uuid())
  transferId       String
  transfer         WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId        String
  product          RiceProduct       @relation(fields: [productId], references: [id])
  sentBags         Int               @default(0)
  sentWeightKg     Decimal           @db.Decimal(18, 4)
  receivedBags     Int               @default(0)
  receivedWeightKg Decimal           @db.Decimal(18, 4)
  shortageBags     Int               @default(0)
  shortageWeightKg Decimal           @default(0.0000) @db.Decimal(18, 4)

  @@index([transferId])
  @@index([productId])
}
