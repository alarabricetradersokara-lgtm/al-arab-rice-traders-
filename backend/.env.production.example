# =========================================================================
# AL ARAB RICE TRADERS ERP & POS — PRODUCTION ENVIRONMENT TEMPLATE
# =========================================================================

# Application Server
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL 16 Enterprise)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://alarab_admin:REPLACE_WITH_SECURE_STRONG_PASSWORD@localhost:5432/alarab_erp?schema=public&connection_limit=50&pool_timeout=30"

# High-Security Cryptographic JWT Keys (Generate with: openssl rand -base64 64)
JWT_SECRET="REPLACE_WITH_STRONG_HEX_SECRET_MIN_64_CHARACTERS"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="REPLACE_WITH_SEPARATE_STRONG_HEX_REFRESH_SECRET_MIN_64_CHARS"
JWT_REFRESH_EXPIRES_IN="30d"

# Authorized CORS Origins (Comma-separated exact domains)
CORS_ORIGIN="https://erp.alarabricetraders.com,https://pos.alarabricetraders.com"

# Logging & Performance
LOG_LEVEL="info"
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="1000" # per IP window
